# Local configuration template. Never commit real keys.
# Browser (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=""
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=zeriv-assets
R2_PUBLIC_URL=https://assets.example.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.example.com
MEDIA_TOKEN_SECRET=""

# Configure only providers used by the feature under test; requests can incur fees.
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""
FAL_KEY=""
# Optional Anthropic credential for automatic brand style generation.
ANTHROPIC_API_KEY=""

# The web app and worker must share the same source and test database.
JOB_SOURCE=portfolio
WORKER_CONCURRENCY=1
WORKER_POLLING_MODE=true
WORKER_HTTP_PORT=8787
WORKER_STALE_PROCESSING_MINUTES=15
WORKER_CRON_SECRET=""
WORKER_CRON_URL=""
CRON_SECRET=""
PIPELINE_INTERNAL_SECRET=""

# Optional auth email / administrators
RESEND_API_KEY=""
INVITE_FROM_EMAIL=Zeriv <support@example.com>
SIGNUP_OTP_FROM_EMAIL=Zeriv <support@example.com>
ADMIN_USER_IDS=""
ADMIN_BASE_PATH=/admin
NEXT_PUBLIC_ADMIN_BASE_PATH=/admin

# Optional payments: use independently provisioned sandbox/test credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PORTONE_API_KEY=""
PORTONE_API_SECRET=""
NEXT_PUBLIC_PORTONE_V1_IMP_KEY=""
NEXT_PUBLIC_PORTONE_V1_CHANNEL_KEY=""
NEXT_PUBLIC_GALAXIA_ITEM_CODE=""
